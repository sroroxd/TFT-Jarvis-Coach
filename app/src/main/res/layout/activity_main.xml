<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TFT JARVIS COACH"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Top-1 Live-Coaching · Bildschirm → KI → Overlay + Sprache"
            android:textColor="#B9B9B9"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:padding="14dp"
            android:text="Status: bereit"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="OpenAI API-Key"
            android:inputType="textPassword"
            android:textColor="@color/white"
            android:textColorHint="#888888" />

        <EditText
            android:id="@+id/modelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Modell"
            android:singleLine="true"
            android:text="gpt-6-luna"
            android:textColor="@color/white"
            android:textColorHint="#888888" />

        <EditText
            android:id="@+id/intervalInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Auto-Intervall in Sekunden"
            android:inputType="number"
            android:singleLine="true"
            android:text="7"
            android:textColor="@color/white"
            android:textColorHint="#888888" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="START COACHING" />

        <Button
            android:id="@+id/rememberButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="MERKEN / JETZT ANALYSIEREN" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="COACHING STOPPEN" />

        <Button
            android:id="@+id/forgetKeyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="API-KEY FELD LEEREN" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Im Spiel erscheint oben ein kleines JARVIS-Overlay. MERKEN analysiert sofort den aktuellen Bildschirm. AUTO wiederholt das Coaching. RESET löscht den Match-Kurzstatus. Keine automatischen Klicks im Spiel."
            android:textColor="#B0B0B0"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
