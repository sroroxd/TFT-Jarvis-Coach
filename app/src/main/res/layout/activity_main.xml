<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TFT JARVIS COACH"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Smart-Auto · lokale Bildschirm- und HUD-Erkennung · KI-Auswertung ausgewählter Spielbilder"
            android:textColor="#B9B9B9"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:padding="14dp"
            android:text="Status: bereit"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="KI-Anbieter"
            android:textColor="#B9B9B9"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/providerInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:spinnerMode="dropdown" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Gemini API-Key"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="#888888" />

        <EditText
            android:id="@+id/modelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gemini Modell"
            android:singleLine="true"
            android:text="gemini-3.8-flash"
            android:textColor="@color/white"
            android:textColorHint="#888888" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Empfohlen: Gemini Free. OpenAI bleibt optional, wird aber nicht automatisch als kostenpflichtiger Fallback verwendet."
            android:textColor="#8F8F8F"
            android:textSize="12sp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="START COACHING" />

        <Button
            android:id="@+id/rememberButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="JETZT ANALYSIEREN" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="COACHING STOPPEN" />

        <Button
            android:id="@+id/forgetKeyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="AKTUELLEN API-KEY LÖSCHEN" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Sprachausgabe &amp; TTS-Stimmen"
            android:textColor="#B9B9B9"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="TTS Engine"
            android:textColor="#888888"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/ttsEngineSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Deutsche Stimme"
            android:textColor="#888888"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/ttsVoiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:spinnerMode="dropdown" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ttsSettingsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SYSTEM TTS-EINSTELLUNGEN"
                android:textSize="11sp" />

            <Button
                android:id="@+id/speechResetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="RESET AUDIO-PARM"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/speechTestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="TESTANSAGE (OHNE API-KEY)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Smart-Auto beobachtet Bildschirmänderungen lokal und sendet nur bei relevanten, stabilen Zustandswechseln ein Bild an die gewählte KI. ANALYSE bleibt als manueller Override verfügbar. Über ⋮ im Overlay findest du Auto, Stumm, Status und Neue Partie / Gedächtnis zurücksetzen."
            android:textColor="#B0B0B0"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
